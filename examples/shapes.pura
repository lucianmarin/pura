# Structs, enums, pointers, and switch/case in Pura
import stdio.h
import stdint.h
import stdbool.h
import math.h

enum ShapeKind:
    CIRCLE = 0
    RECTANGLE = 1

struct Vec2:
    x: f64
    y: f64

struct Shape:
    kind: ShapeKind
    origin: Vec2
    width: f64
    height: f64

def area(s: addr[const Shape]) -> f64:
    if s == nil:
        return 0.0
    switch s.kind:
        case CIRCLE:
            return 3.141592653589793 * s.width * s.width
        case RECTANGLE:
            return s.width * s.height
        default:
            return 0.0

def main() -> i32:
    c: Shape
    c.kind = CIRCLE
    c.origin.x = 0.0
    c.origin.y = 0.0
    radii: f64[3] = [f64(i + 1) * 2.5 for i in range(3)]
    for i in range(3):
        c.width = radii[i]
        c.height = radii[i]
        printf("Circle area (r=%.1f): %.4f\n", c.width, area(c.addr))
    return 0
