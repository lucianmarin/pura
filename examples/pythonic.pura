# Pythonic ergonomics in Pura: lambda, enumerate(), zip(), reversed(), f-strings,
# ternary, membership (`in` / `not in`), `//`, `**`, chained comparisons, and multi-line syntax

import vector
import set
import map
import cstdint

def main() -> i32:
    banner: cstr = """=== Pythonic Pura ===
lambda, enumerate, zip, reversed"""

    # Multi-line nested comprehension
    nums: list[i32] = [
        x * 10 + y
        for x in range(1, 4)
        for y in range(2)
        if x + y > 1
    ]

    # Inline lambda + negative indexing + ternary
    inc: auto = lambda v: i32 -> i32: v + 1
    tag: cstr = "big" if nums[-1] > 20 else "small"

    # Chained comparisons, `not` precedence, `is not`, `//`, `**`
    ok: bool = 0 < nums[0] < 50 and not 1 == 2 and tag is not nil
    fdiv: i32 = -7 // 2
    power: i32 = i32(2 ** 3)

    # Set/dict membership (`in` / `not in`) + `del`
    seen: set[i32] = {n for n in nums}
    weights: dict[i32, i32] = {n: inc(n) for n in nums}
    del weights[nums[0]]
    has_20: bool = 20 in seen and 99 not in seen

    print(banner)
    print(f"tag={tag} ok={ok} has_20={has_20} -7//2={fdiv} 2**3={power}")

    # enumerate(), zip(), and reversed()
    for idx, val in enumerate(nums):
        print(f"  enum[{idx}] = {val}")

    labels: list[cstr] = {"a", "b", "c", "d", "e"}
    for label, val in zip(labels, nums):
        print(f"  zip({label}, {val})")

    print("  reversed:")
    for r in reversed(nums):
        print(f"    {r}")
    return 0
