# Minimal introduction to Pura types, functions, and loops
import stdio.h
import stdint.h
import stdbool.h

MAX_GREETINGS = 3

def greet(name: cstr, count: i32) -> i32:
    if name == nil or count <= 0:
        return 0
    steps: i32[MAX_GREETINGS] = [i + 1 for i in range(MAX_GREETINGS)]
    for i in range(count):
        printf("[%d] Hello from Pura, %s!\n", steps[i], name)
    return count

def main() -> i32:
    sent: i32 = greet("World", MAX_GREETINGS)
    if sent > 0 and not (sent > 10):
        printf("Successfully sent %d greetings.\n", sent)
    return 0
